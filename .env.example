# ─── Environment ─────────────────────────────────────────────────────────────

# Port for the backend API server (default: 4000)
PORT=4000

# Base URL of the frontend application (used for OAuth redirects, CORS)
APP_URL=http://localhost:3000

# Path to SQLite database file (relative to project root)
DATABASE_PATH=./praconnect.db

# ─── Gmail SMTP (Email OTP delivery) ─────────────────────────────────────────
# Use a Google App Password from: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (add this in Google Cloud Console):
#   Development: http://localhost:4000/api/auth/google/callback
#   Production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Session ─────────────────────────────────────────────────────────────────
# Not currently used in token generation (Web Crypto is used directly),
# but kept for future HMAC signing if needed. Set to a long random string.
SESSION_SECRET=change-me-to-a-long-random-secret-string

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# In-memory rate limiter (single-instance). Set TRUST_PROXY=true ONLY when the
# server sits directly behind a trusted reverse proxy that overwrites
# x-forwarded-for; otherwise clients could spoof it to bypass rate limits.
# Individual limits can be tuned via RATE_LIMIT_<NAME>_MAX and
# RATE_LIMIT_<NAME>_WINDOW_MS (e.g. RATE_LIMIT_LOGIN_MAX=5).
TRUST_PROXY=false

# ─── WebRTC (ICE / TURN) ─────────────────────────────────────────────────────
# Server-side ICE & TURN Configuration (GET /api/calling/ice-servers)
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=your-turn-rest-api-secret-key-placeholder
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Public STUN servers (comma-separated). When unset, defaults to Google +
# Cloudflare STUN. Custom values replace the defaults entirely.
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Legacy singular aliases (VITE_STUN_SERVER / VITE_TURN_SERVER) still work.
#
# Optional TURN relay configuration (UDP, TCP, and TLS examples):
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
#
# SECURITY: VITE_* values are bundled into the browser — anyone can read them.
# Production MUST use short-lived/ephemeral TURN credentials (e.g. a TURN REST
# API that mints time-limited credentials). NEVER put a long-lived TURN secret
# here, and never commit real credentials to the repository. Without TURN the
# app still works: STUN-only ICE with host/srflx/relay candidate gathering.
#
# Diagnostics only: force relay-only ICE (rejects host/srflx candidates).
# Leave false (default) in production.
VITE_WEBRTC_RELAY_ONLY=false

# ─── Production (Node.js & Cloudflare Workers) ─────────────────────────────────
#
# 1. Cloudflare Workers + D1 Deployment:
#    Create your D1 database:
#      npx wrangler d1 create praconnect-db
#    (Paste the generated database_id into wrangler.jsonc under d1_databases)
#
#    Apply the database schema to remote D1:
#      npm run db:migrate:remote
#
#    Set production secrets in Cloudflare:
#      npx wrangler secret put SESSION_SECRET
#      npx wrangler secret put GOOGLE_CLIENT_SECRET
#      npx wrangler secret put SMTP_PASS
#      npx wrangler secret put B2_APPLICATION_KEY_ID
#      npx wrangler secret put B2_APPLICATION_KEY
#      npx wrangler secret put B2_BUCKET_NAME
#      npx wrangler secret put B2_ENDPOINT
#
#    Deploy the full application to Cloudflare:
#      npm run deploy
#
# ─── Backblaze B2 (Media / Object Storage) ───────────────────────────────────
# Required in production with Cloudflare Workers (or optional in local Node dev).
# Create a bucket & application key at: https://secure.backblaze.com/app_keys.htm
# Server-side secrets / configuration only — NEVER expose to the browser.
#
# B2_APPLICATION_KEY_ID = Backblaze Application Key ID (placeholder)
# B2_APPLICATION_KEY    = Backblaze Application Key secret (placeholder)
# B2_BUCKET_NAME        = Backblaze bucket name
# B2_ENDPOINT           = Backblaze S3-compatible endpoint
# B2_BUCKET_ID          = Backblaze bucket ID (placeholder)
B2_APPLICATION_KEY_ID=YOUR_B2_KEY_ID
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_BUCKET_NAME=praconnect-media
B2_ENDPOINT=s3.ca-east-006.backblazeb2.com
B2_BUCKET_ID=YOUR_B2_BUCKET_ID
#
# 2. Traditional Node.js Server Deployment:
#    npm run start runs with NODE_ENV=production (via cross-env) and validates
#    the settings below before starting. Validation failures are clear, fail
#    fast, and never print secret values.
#
# Required in Node.js production:
#   APP_URL       must start with https:// (production session cookies are
#                 Secure-only — without TLS, sessions will not persist)
#   DATABASE_PATH absolute persistent path OUTSIDE the project (e.g. on a
#                 mounted volume) and never inside dist/ — otherwise a rebuild
#                 would wipe your data. Example: DATABASE_PATH=/var/lib/praconnect/praconnect.db
#
# Static serving of dist/ is enabled automatically when NODE_ENV=production.
#   STATIC_DIR    optional override of the static files directory
#                 (default: ./dist). Do not set this in normal deployments.
#
# Non-secret production values example:
#   NODE_ENV=production
#   APP_URL=https://praconnect.example.com
#   DATABASE_PATH=/var/lib/praconnect/praconnect.db
#
# Not required (documented fallbacks):
#   SMTP_*        partial SMTP config logs a warning; email features stay off
#   GOOGLE_*      without them, Google sign-in is hidden
#   VITE_TURN_*   without them, WebRTC uses STUN-only ICE (still works)
#
# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Movie conversion (Phase 6.9: MKV support) ─────────────────────────────────
# MKV files are not reliably playable in browsers, so the server converts them
# to a browser-compatible MP4 (H.264 + AAC, fast-start) with FFmpeg before the
# room ever receives the playable URL.
#
# System requirement: FFmpeg (and optionally FFprobe for codec-aware MOV/MP4
# handling) must be installed on the server. Without FFmpeg, MKV uploads are
# rejected with a clear message instead of leaving the room with an unplayable
# movie. Verify with:  ffmpeg -version
#
# Optional overrides:
#   FFMPEG_PATH=            absolute path to the ffmpeg binary (default: PATH)
#   FFPROBE_PATH=           absolute path to the ffprobe binary (default: PATH)
#   MEDIA_CONVERT_TIMEOUT_MS=1800000   conversion timeout (default 30 minutes)
#
# FFmpeg is executed only via argument arrays (no shell), with server-generated
# filenames, and its output is never exposed to end users.

# ─── Admin ───────────────────────────────────────────────────────────────────
# Phase A/D: designated administrator accounts are promoted to role='admin'
# server-side. ADMIN_EMAILS names the accounts (comma-separated) — never passwords.
# Case-insensitive, trims whitespace, supports multiple admins, deduplicates.
# At startup and on account verification/login, the server promotes matching
# accounts. Unknown emails are ignored until the account is registered.
# Existing admins are preserved and not demoted.
# Single-admin fallback ADMIN_EMAIL is also supported for backward compatibility.
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ─── Media Library (Phase C: large-file admin uploads) ────────────────────────
# The admin Media Library stores binary bytes behind the MediaStorage
# abstraction. Local development uses LocalDiskStorage rooted at
# MEDIA_STORAGE_DIR; a future production deployment can swap in object storage
# without touching any route.
#
#   MEDIA_STORAGE_DIR=uploads/library    where library bytes live
#                                        (default: ./uploads/library)
#   MAX_ADMIN_MEDIA_BYTES=10737418240    hard cap per library file —
#                                        default 10 GiB (a SAFE upper bound;
#                                        unlimited upload is never allowed)
#   MEDIA_UPLOAD_CHUNK_BYTES=8388608     client chunk size hint — default 8 MiB.
#                                        Client requests are clamped to
#                                        [256 KiB, 64 MiB] server-side.
#   MEDIA_CONVERT_TIMEOUT_MS=1800000     FFmpeg conversion hard timeout
#                                        (default 30 minutes)
#   MEDIA_RETAIN_ORIGINAL=0              keep the uploaded ORIGINAL after
#                                        conversion (1/true to retain, default
#                                        off — only the playable MP4 is kept so
#                                        huge files are not duplicated)
#   MEDIA_SESSION_TTL_MS=86400000        upload sessions expire after this long
#                                        without progress (default 24 h)
#   ORPHAN_MEDIA_RETENTION_MS=3600000    grace period before unreferenced
#                                        library files are swept (default 1 h)
#
# The FFmpeg pipeline (container validation → probe codecs → remux/transcode to
# H.264 + AAC MP4 with faststart → poster) reuses the safe runner from
# server/uploads/transcode.ts: argument arrays only (no shell), server-generated
# filenames, hard timeout. Without FFmpeg/FFprobe, library uploads fail fast
# with a clear 'failed' status instead of leaving an unplayable item.

# ─── Cleanup & retention (Phase 6.8) ──────────────────────────────────────────
# A single periodic maintenance worker sweeps the database and uploads (default
# every 30s). The timer is unref'd and stopped during graceful shutdown.
# Aggregate counts only are logged — never tokens, hashes, emails, or
# credentials.
#
# Auth data: expired sessions / OTPs / password-reset tokens / pending signups
# are deleted as soon as they expire. loginActivity is kept for this long:
LOGIN_ACTIVITY_RETENTION_MS=2592000000
#
# Room events: chat and room state are persisted per room for SSE replay (500
# events). A safety cap bounds the table and an age-based retention drops stale
# events while preserving the active replay window:
ROOM_EVENTS_MAX_PER_ROOM=2000
ROOM_EVENTS_RETENTION_MS=86400000
#
# Uploads: files whose DB record is gone are deleted only after this grace
# period (protects in-flight finalization); media files of deleted rooms are
# removed immediately:
ORPHAN_UPLOAD_RETENTION_MS=3600000
#
# Rooms: hard participant ceiling for full-mesh WebRTC (N peer video streams).
# Client-provided maxParticipants values above this are clamped server-side:
MAX_ROOM_PARTICIPANTS=12
